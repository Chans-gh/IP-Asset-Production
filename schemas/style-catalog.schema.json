{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ip-asset-production/styles/catalog.schema.json",
  "title": "StylePresetCatalog",
  "type": "object",
  "required": [
    "version",
    "total_styles",
    "groups",
    "styles"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "total_styles": {
      "type": "integer",
      "const": 48
    },
    "groups": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "name_zh"
        ],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "name_zh": {
            "type": "string",
            "minLength": 2
          }
        },
        "additionalProperties": false
      }
    },
    "styles": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/stylePreset"
      }
    }
  },
  "$defs": {
    "stylePreset": {
      "type": "object",
      "required": [
        "style_id",
        "group_id",
        "display_name_zh",
        "description_zh",
        "medium",
        "tradition",
        "proportions",
        "material",
        "linework",
        "mood",
        "detail",
        "supported_subjects",
        "prompt_fragment_en",
        "negative_prompt_en",
        "preview_prototype_preference",
        "status"
      ],
      "properties": {
        "style_id": {
          "type": "string",
          "pattern": "^STYLE-0[0-4][0-9]$"
        },
        "group_id": {
          "type": "string",
          "pattern": "^G0[1-8]$"
        },
        "display_name_zh": {
          "type": "string",
          "minLength": 2
        },
        "description_zh": {
          "type": "string",
          "minLength": 4
        },
        "medium": {
          "type": "string"
        },
        "tradition": {
          "type": "string"
        },
        "proportions": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "linework": {
          "type": "string"
        },
        "mood": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "detail": {
          "type": "string"
        },
        "supported_subjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "anime_human",
              "animal",
              "anthropomorphic_object",
              "fantasy_creature"
            ]
          }
        },
        "prompt_fragment_en": {
          "type": "string",
          "minLength": 36
        },
        "negative_prompt_en": {
          "type": "string",
          "minLength": 8
        },
        "preview_prototype_preference": {
          "enum": [
            "anime_human",
            "animal",
            "anthropomorphic_object",
            "fantasy_creature"
          ]
        },
        "status": {
          "enum": [
            "specified",
            "in_review",
            "approved",
            "retired"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
