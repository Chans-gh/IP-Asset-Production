{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "version",
    "kind",
    "category",
    "title",
    "prompt_id",
    "applicable_ip_types",
    "use_cases",
    "outputs",
    "dependencies",
    "default_priority"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "foundation",
        "application"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "minLength": 1
    },
    "applicable_ip_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "digital_human",
          "anime_human",
          "cartoon_animal",
          "anthropomorphic_object",
          "fantasy_creature",
          "other"
        ]
      }
    },
    "required_topology_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "width_px",
          "height_px",
          "format",
          "alpha_required"
        ],
        "properties": {
          "width_px": {
            "type": "integer",
            "minimum": 1
          },
          "height_px": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "PNG",
              "JPEG",
              "WEBP",
              "PDF"
            ]
          },
          "alpha_required": {
            "type": "boolean"
          },
          "color_mode": {
            "type": "string"
          },
          "ppi": {
            "type": [
              "number",
              "null"
            ]
          },
          "trim_mm": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "bleed_mm": {
            "type": [
              "number",
              "null"
            ]
          },
          "safe_margin_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 0.5
          }
        }
      }
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "qa_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "default_priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    }
  }
}
