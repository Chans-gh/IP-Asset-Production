{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "character_id",
    "character_version",
    "tasks",
    "approval_status"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "character_version": {
      "type": "string",
      "minLength": 1
    },
    "user_use_cases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "approved",
        "rejected"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "template_id",
          "priority",
          "applicability",
          "dependencies"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "applicability": {
            "type": "string",
            "enum": [
              "applicable",
              "adapt",
              "skip"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "variant": {
            "type": "string"
          },
          "output_profile_id": {
            "type": "string"
          },
          "skip_reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
