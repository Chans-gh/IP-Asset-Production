{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenerationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "attempt",
    "outputs"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "generating",
        "postprocessing",
        "qa_pending",
        "passed",
        "needs_review",
        "failed",
        "exported"
      ]
    },
    "provider": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "native_size": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "width_px",
          "height_px",
          "format"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "width_px": {
            "type": "integer",
            "minimum": 1
          },
          "height_px": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "alpha_verified": {
            "type": "boolean"
          },
          "qa_status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "needs_review"
            ]
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "qa_summary": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
